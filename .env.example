# Copy to .env — gitignored. Credentials also resolve from the
# com.isbkch.YouTube-AI-Studio Keychain items (openai, gemini); Gemini additionally
# reads GOOGLE_API_KEY.

# OpenAI Director/transcription (billed).
# OPENAI_API_KEY=sk-...

# Gemini image (Nano Banana) and music (Lyria) generation (billed).
# GEMINI_API_KEY=...
# WTS_GEMINI_IMAGE_MODEL=
# WTS_GEMINI_MUSIC_MODEL=

# Director model override.
# WTS_MODEL=gpt-5.4

# Image generation (billed per image; shares OPENAI_API_KEY).
# WTS_IMAGE_MODEL=gpt-image-1
# Max generated stills per visual-direction pass.
# WTS_IMAGE_BUDGET=8
# Set to "off" to skip vision review and frame sampling during builds.
# WTS_VISUAL_QA=on

# Local whisper.cpp transcription (free, offline).
# WTS_WHISPER_MODEL=~/.whisper-models/ggml-small.bin

# Tool overrides (auto-detected when unset).
# WTS_FFMPEG_PATH=
# WTS_FFPROBE_PATH=
# WTS_BLENDER_PATH=

# YouTube publishing through the local youtubeuploader CLI.
# WTS_YOUTUBEUPLOADER_PATH=
# WTS_YOUTUBE_ARGS=

# Library location override (default ~/Movies/YouTube-AI-Studio).
# WTS_HOME=
