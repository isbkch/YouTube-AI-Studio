                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
                    },
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "durationFrames": {
                      "type": "integer",
                      "minimum": 12,
                      "maximum": 9007199254740991
                    },
                    "placement": {
                      "type": "string",
                      "enum": ["inset", "fullframe"]
                    },
                    "inset": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "width": {
                              "type": "number",
                              "minimum": 0.2,
                              "maximum": 1
                            }
                          },
                          "required": ["x", "y", "width"],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "motion": {
                      "type": "string",
                      "enum": [
                        "none",
                        "zoom-in",
                        "zoom-out",
                        "pan-left",
                        "pan-right"
                      ]
                    },
                    "asset": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "engine": {
                              "type": "string",
                              "const": "gpt-image"
                            },
                            "template": {
                              "type": "string",
                              "const": "GeneratedStill"
                            },
                            "templateVersion": {
                              "type": "string",
                              "const": "1.0.0"
                            },
                            "parameters": {
                              "type": "object",
                              "properties": {
                                "brief": {
                                  "type": "string",
                                  "minLength": 10,
                                  "maxLength": 600
                                },
                                "style": {
                                  "type": "string",
                                  "enum": [
                                    "photoreal",
                                    "technical-illustration",
                                    "isometric-diagram",
                                    "cinematic",
                                    "clean-3d",
                                    "minimal-lineart"
                                  ]
                                },
                                "palette": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "maxLength": 120
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "avoid": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "maxLength": 200
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "quality": {
                                  "type": "string",
                                  "enum": ["low", "medium", "high"]
                                },
                                "expectsText": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "brief",
                                "style",
                                "palette",
                                "avoid",
                                "quality",
                                "expectsText"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "engine",
                            "template",
                            "templateVersion",
                            "parameters"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "narrationHook": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "id",
                    "startFrame",
                    "durationFrames",
                    "placement",
                    "inset",
                    "motion",
                    "asset",
                    "narrationHook"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "sceneId", "broll"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "setAudioDesign"
              },
              "audioDesign": {
                "type": "object",
                "properties": {
                  "music": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "trackId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "gainDb": {
                            "type": "number",
                            "minimum": -42,
                            "maximum": -6
                          },
                          "duckToDb": {
                            "type": "number",
                            "minimum": -48,
                            "maximum": -6
                          },
                          "fadeInSec": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5
                          },
                          "fadeOutSec": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5
                          }
                        },
                        "required": [
                          "trackId",
                          "gainDb",
                          "duckToDb",
                          "fadeInSec",
                          "fadeOutSec"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sfx": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
                        },
                        "atFrame": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "trackId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "gainDb": {
                          "type": "number",
                          "minimum": -24,
                          "maximum": 0
                        }
                      },
                      "required": ["id", "atFrame", "trackId", "gainDb"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["music", "sfx"],
                "additionalProperties": false
              }
            },
            "required": ["type", "audioDesign"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "createdAt",
    "originatingRequest",
    "rationale",
    "affectedScenes",
    "previousVersion",
    "resultingVersion",
    "operations"
  ],
  "additionalProperties": false
}
