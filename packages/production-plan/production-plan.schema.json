{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "scriptVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "transcriptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frameRate": {
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 180,
          "maximum": 2160
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "durationFrames": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 324000
    },
    "director": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "provider",
        "model",
        "summary"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sourceInFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "narration": {
            "type": "string",
            "maxLength": 20000
          },
          "transcriptSegmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
            }
          },
          "camera": {
            "type": "object",
            "properties": {
              "recordingId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
              },
              "framing": {
                "type": "string",
                "enum": [
                  "wide",
                  "medium",
                  "close"
                ]
              },
              "punchIn": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.35
              }
            },
            "required": [
              "recordingId",
              "framing",
              "punchIn"
            ],
            "additionalProperties": false
          },
          "visual": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "presenter",
                  "graphic"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 1000
              },
              "graphic": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "engine": {
                        "type": "string",
                        "const": "remotion"
                      },
                      "template": {
                        "type": "string",
                        "enum": [
                          "Callout",
                          "ArchitectureFlow",
                          "ChapterTitle"
                        ]
                      },
                      "templateVersion": {
                        "type": "string",
                        "const": "1.0.0"
                      },
                      "parameters": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "subtitle": {
                            "type": "string",
                            "maxLength": 180
                          },
                          "nodes": {
                            "maxItems": 5,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 24
                            }
                          },
                          "emphasis": {
                            "type": "integer",
                            "minimum": -1,
                            "maximum": 4
                          }
                        },
                        "required": [
                          "title",
                          "subtitle",
                          "nodes",
                          "emphasis"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "engine",
                      "template",
                      "templateVersion",
                      "parameters"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "description",
              "graphic"
            ],
            "additionalProperties": false
          },
          "audio": {
            "type": "object",
            "properties": {
              "gainDb": {
                "type": "number",
                "minimum": -24,
                "maximum": 12
              }
            },
            "required": [
              "gainDb"
            ],
            "additionalProperties": false
          },
          "transition": {
            "type": "string",
            "const": "cut"
          },
          "enabled": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "startFrame",
          "durationFrames",
          "sourceInFrame",
          "narration",
          "transcriptSegmentIds",
          "camera",
          "visual",
          "audio",
          "transition",
          "enabled",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "version",
    "createdAt",
    "scriptVersion",
    "transcriptHash",
    "frameRate",
    "resolution",
    "durationFrames",
    "director",
    "scenes"
  ],
  "additionalProperties": false
}
